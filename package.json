{
	"name": "agent-end-notify",
	"version": "1.0.0",
	"description": "Pi fleet notifications when agents end",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "bun build index.ts --outdir dist --target node --format esm",
		"build:types": "bunx tsc -p tsconfig.build.json",
		"prepublishOnly": "bun run build && bun run build:types",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"format": "bunx biome format --write .",
		"lint": "bunx biome lint .",
		"typecheck": "bunx tsc --noEmit",
		"check": "bun run format && bun run lint && bun run typecheck",
		"hooks:install": "bunx lefthook install",
		"hooks:run": "bunx lefthook run pre-commit"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/node": "^24.0.0",
		"bun-types": "latest",
		"lefthook": "^1.7.17",
		"typescript": "^5.9.3"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"packageManager": "bun@^1.1.0",
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.79.4",
		"@nats-io/transport-node": "^3.4.0",
		"typia": "^12.1.1"
	}
}
